{
  "flow": "init",
  "model": "claude-sonnet-5-5",
  "metrics": [
    {
      "id": "complete",
      "label": "Complete",
      "kind": "binary"
    },
    {
      "id": "ran",
      "label": "Ran DD",
      "kind": "binary"
    },
    {
      "id": "config",
      "label": "Config",
      "kind": "binary"
    },
    {
      "id": "tests",
      "label": "Tests",
      "kind": "binary"
    },
    {
      "id": "no_harm",
      "label": "No harm",
      "kind": "binary"
    },
    {
      "id": "ci",
      "label": "CI",
      "kind": "binary"
    },
    {
      "id": "report",
      "label": "Report",
      "kind": "binary"
    }
  ],
  "perf_fields": [
    "latency_s",
    "tool_calls",
    "turns",
    "dd_runs",
    "files_changed",
    "usage"
  ],
  "harness_paths": [
    "evals/lib/claude-run.mjs",
    "evals/init/grade.mjs",
    "evals/init/reference.doc-detective.json",
    "evals/test/grade.mjs",
    "evals/spec-generation/grade.mjs"
  ],
  "harness_note": "harness_paths lists every module the grader loads, including transitive ones: grade.mjs imports from evals/test/grade.mjs and evals/spec-generation/grade.mjs. A change to either can change grading, so it also needs the init harness approved again.",
  "prices": {
    "claude-sonnet-5-5": {
      "in": 2,
      "out": 10
    },
    "claude-haiku-4-5": {
      "in": 1,
      "out": 5
    }
  },
  "train_ids": [
    "docs-dir-ui",
    "readme-only-http",
    "cli-readme",
    "exclude-changelog",
    "exclude-issue-template",
    "env-app-down",
    "stale-button",
    "existing-inline",
    "existing-workflow-offer",
    "ci-text",
    "stale-moved-page",
    "stale-api-status",
    "rst-docs",
    "exclude-reference-page",
    "existing-yml-inline",
    "ci-flag-no-remote",
    "env-down-auto-fix",
    "ci-words-actions"
  ],
  "test_ids": [
    "mixed-md-mdx",
    "monorepo-two-dirs",
    "docusaurus-website",
    "adoc-docs",
    "exclude-node-modules",
    "exclude-vendor",
    "exclude-dist-build",
    "exclude-generated-api",
    "env-api-down",
    "env-admin-down",
    "env-metrics-down",
    "stale-heading",
    "stale-delay-message",
    "stale-and-down",
    "existing-yaml-new-doc",
    "existing-stale",
    "ci-flag",
    "ci-text-existing-workflow",
    "gitlab-remote",
    "no-remote"
  ],
  "reps": 3,
  "goal": {
    "target": "complete",
    "direction": "higher",
    "hold": [
      "no_harm",
      "ci"
    ]
  },
  "scope": {
    "will_change": [
      "SKILL.md body of doc-detective-init",
      "its references/",
      "src/skills/_shared/"
    ],
    "off_limits": [
      "frontmatter descriptions",
      "scripts",
      "hooks",
      "build.js",
      "evals/"
    ]
  },
  "split_note": "30 cases, 20 held out (67%), written before any session ran. Train has the plain layout, README-only HTTP, and CLI cases, two exclusion traps (CHANGELOG, issue template), one down service, one stale doc, one existing setup, one existing workflow, and CI asked in words. Every kind has at least two held-out cases, and the held-out side has the harder variants: MDX, monorepo, Docusaurus, AsciiDoc, the other four exclusion traps, three down services, three stale docs, the YAML and stale existing setups, --ci, CI beside an existing workflow, and both non-GitHub remotes.",
  "harness_sha": "8a009a54a9501f9e2c44049816c8a53ad2d9828d603bc44435e0289042bc483a"
}
