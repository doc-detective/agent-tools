{
  "flow": "spec-generation",
  "model": "claude-sonnet-5-5",
  "metrics": [
    {
      "id": "complete",
      "label": "Complete",
      "kind": "binary"
    },
    {
      "id": "verified_coverage",
      "label": "Verified cov.",
      "kind": "continuous"
    },
    {
      "id": "passes",
      "label": "Spec passes",
      "kind": "binary"
    },
    {
      "id": "coverage",
      "label": "Step coverage",
      "kind": "continuous"
    },
    {
      "id": "spec_written",
      "label": "Spec written",
      "kind": "binary"
    }
  ],
  "perf_fields": [
    "latency_s",
    "tool_calls",
    "turns",
    "spec_steps",
    "usage"
  ],
  "harness_paths": [
    "evals/lib/claude-run.mjs",
    "evals/spec-generation/grade.mjs",
    "evals/spec-generation/doc-detective.config.json"
  ],
  "prices": {
    "claude-sonnet-5-5": {
      "in": 2,
      "out": 10
    }
  }
}
