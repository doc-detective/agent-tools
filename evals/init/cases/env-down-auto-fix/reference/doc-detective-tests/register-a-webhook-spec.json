{
  "description": "Tests docs/register-a-webhook.md.",
  "tests": [
    {
      "testId": "register-a-webhook",
      "steps": [
        {
          "httpRequest": {
            "url": "http://localhost:8098/api/webhooks",
            "method": "post",
            "request": {
              "headers": {
                "Content-Type": "application/json"
              },
              "body": {
                "url": "https://example.com/hooks/orders",
                "event": "order.created"
              }
            },
            "statusCodes": [
              200
            ],
            "response": {
              "body": {
                "url": "https://example.com/hooks/orders",
                "event": "order.created"
              }
            }
          }
        }
      ]
    }
  ]
}
