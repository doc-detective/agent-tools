{
  "specId": "dd-docs-runcode",
  "description": "Doc Detective docs: the runCode action reference. The page's inline tests run every example except the output-regression one.",
  "tests": [
    {
      "testId": "runcode-python-basic",
      "steps": [
        {
          "stepId": "runcode-python",
          "description": "Run a basic Python script and verify its output.",
          "runCode": {
            "language": "python",
            "code": "print('hello world')",
            "stdio": "hello world"
          }
        }
      ]
    },
    {
      "testId": "runcode-javascript-stdio",
      "steps": [
        {
          "stepId": "runcode-js",
          "description": "Run JS code and check the output.",
          "runCode": {
            "language": "javascript",
            "code": "console.log('Hello from Node!');",
            "stdio": "Hello from Node!"
          }
        }
      ]
    },
    {
      "testId": "runcode-bash-exitcode",
      "steps": [
        {
          "stepId": "runcode-bash-exit",
          "description": "Run a failing Bash command and expect exit code 1.",
          "runCode": {
            "language": "bash",
            "code": "false",
            "exitCodes": [
              1
            ]
          }
        }
      ]
    },
    {
      "testId": "runcode-with-args",
      "steps": [
        {
          "stepId": "runcode-args",
          "description": "Pass an argument to a Bash snippet and check it prints.",
          "runCode": {
            "language": "bash",
            "code": "echo \"first arg: $1\"",
            "args": [
              "hello"
            ],
            "stdio": "first arg: hello"
          }
        }
      ]
    },
    {
      "testId": "runcode-variable-capture",
      "steps": [
        {
          "stepId": "runcode-set-var",
          "description": "Set a variable based on Python output.",
          "runCode": {
            "language": "python",
            "code": "import sys; sys.stdout.write('setup')",
            "stdio": "/.+/"
          },
          "variables": {
            "SETUP_VAL": "$$stdio.stdout"
          }
        },
        {
          "stepId": "runcode-use-var",
          "description": "Echo and validate the variable using Bash.",
          "runCode": {
            "language": "bash",
            "code": "echo $SETUP_VAL",
            "stdio": "setup"
          }
        }
      ]
    },
    {
      "testId": "runcode-background-server",
      "steps": [
        {
          "stepId": "runcode-start-server",
          "description": "Start an HTTP server in the background and wait for port 8088.",
          "runCode": {
            "language": "javascript",
            "code": "require('http').createServer((req, res) => res.end('ok')).listen(8088);",
            "background": {
              "name": "runcode-api",
              "waitUntil": {
                "port": 8088
              }
            },
            "timeout": 15000
          }
        },
        {
          "stepId": "runcode-verify-server",
          "description": "Confirm the server responds on the port it claimed to be ready on.",
          "httpRequest": {
            "url": "http://localhost:8088",
            "response": {
              "body": "ok"
            }
          }
        },
        {
          "stepId": "runcode-stop-server",
          "description": "Stop the server.",
          "closeSurface": "runcode-api"
        }
      ]
    }
  ]
}
