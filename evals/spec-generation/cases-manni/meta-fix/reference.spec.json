{
  "specId": "manni-meta-fix",
  "description": "manni docs meta/fix, run in a repo whose docs/guide.md fails the check the page decodes.",
  "tests": [
    {
      "testId": "reproduce-and-confirm",
      "steps": [
        {
          "description": "Run manni meta on just the file: the missing-field failure the page decodes.",
          "runShell": {
            "command": "npx @hawkeyexl/manni meta validate docs/guide.md",
            "exitCodes": [
              1
            ],
            "stdio": "/✗ docs/guide.md[\\s\\S]*\\(root\\)  must have required property 'type'[\\s\\S]*\\[google:okf:0\\.1\\]/"
          }
        },
        {
          "description": "Apply the fix: add the type field to the frontmatter.",
          "runShell": {
            "command": "node -e \"const f=require('fs'),p='docs/guide.md';f.writeFileSync(p,f.readFileSync(p,'utf8').replace(/^description:.*\\n/m,m=>m+'type: concept\\n'))\""
          }
        },
        {
          "description": "Run it again and confirm the green check.",
          "runShell": {
            "command": "npx @hawkeyexl/manni meta validate docs/guide.md",
            "exitCodes": [
              0
            ],
            "stdio": "1 file checked, 1 passed, 0 failed, 0 errors"
          }
        }
      ]
    }
  ]
}
