{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["type", "title", "endpoint"],
  "properties": {
    "type": { "const": "api-reference" },
    "title": { "type": "string", "minLength": 1 },
    "endpoint": { "type": "string", "pattern": "^(GET|POST|PUT|PATCH|DELETE) /" }
  }
}
