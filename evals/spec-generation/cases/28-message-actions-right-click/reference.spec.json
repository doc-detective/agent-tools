{
  "tests": [
    {
      "testId": "message-actions",
      "steps": [
        {
          "goTo": "http://localhost:8092/click-shorthand.html"
        },
        {
          "click": {
            "elementText": "Reveal by selector",
            "button": "right"
          }
        },
        {
          "find": "Right-click landed"
        },
        {
          "click": {
            "elementText": "Reveal by selector",
            "button": "left"
          }
        },
        {
          "find": "Selector click landed"
        },
        {
          "click": "Reveal via regex match"
        },
        {
          "find": "Regex click landed"
        },
        {
          "runBrowserScript": {
            "script": "return Array.from(document.querySelectorAll('#messages p')).map(p => p.textContent).join('|');",
            "output": "Right-click landed|Selector click landed|Regex click landed"
          }
        }
      ]
    }
  ]
}
