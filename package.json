{
  "name": "agent-tools",
  "version": "2.1.4",
  "private": true,
  "repository": "github:doc-detective/agent-tools",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "node build.js",
    "build:no-scripts": "node build.js --no-scripts",
    "build:doc-testing": "cd src/skills/doc-detective-test/scripts/src && npm run build",
    "build:inline": "echo 'No source directory for the inject script; rebuild not available'",
    "test:hooks": "mocha tests/hooks/hook*.test.js --timeout 30000",
    "test:hooks:integration": "mocha tests/hooks/integration.test.js --timeout 180000",
    "test:codex-plugin": "mocha tests/hooks/codex-plugin.test.js --timeout 30000",
    "test:cursor-plugin": "mocha tests/hooks/cursor-plugin.test.js --timeout 30000",
    "test:doc-testing": "cd skills/doc-detective-test && ./scripts/test-skill.sh",
    "test:inline": "cd skills/doc-detective-inject && ./scripts/test-skill.sh",
    "prepare": "husky",
    "validate:skills": "./scripts/doc-detective-validate-skills.sh",
    "test:lsp-plugin": "mocha tests/hooks/lsp-plugin.test.js --timeout 30000",
    "semantic-release": "semantic-release"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.11",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "doc-detective-common": "^5.0.0",
    "husky": "^9.1.7",
    "mocha": "^12.0.3",
    "semantic-release": "^25.0.9"
  }
}
