{
  "dependencies": {
    "doc-detective-common": "5.0.0-v5-rc.9"
  },
  "devDependencies": {
    "esbuild": "^0.27.2"
  },
  "scripts": {
    "prebuild": "npm install",
    "build": "npm run build-fix-tests && npm run build-validate-test",
    "build-fix-tests": "npx esbuild fix-tests.mjs --bundle --minify --outfile=../fix-tests.js --platform=node",
    "build-validate-test": "npx esbuild validate-test.mjs --bundle --minify --outfile=../doc-detective-validate-test.js --platform=node"
  }
}
